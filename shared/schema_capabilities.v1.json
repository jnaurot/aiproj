{
  "schemaVersion": 1,
  "edgeModes": ["work", "param", "control"],
  "edgeKinds": ["data_link", "control_link"],
  "workItemModes": ["artifact", "json_items", "table_rows"],
  "processingPolicies": {
    "consumeModes": ["once", "single_item", "batch"],
    "defaults": {
      "consume_mode": "once",
      "batch_size": 1,
      "max_inflight": 1
    }
  },
  "portDeclarations": {
    "planes": ["work", "param", "control"],
    "directions": ["in", "out"],
    "cardinality": ["one", "many"],
    "defaults": {
      "required": false,
      "cardinality": "many"
    }
  },
  "inputContracts": {
    "workInputs": { "behavior": "single_item" },
    "paramInputs": { "behavior": "read_once" },
    "controlInputs": { "behavior": "continuous" }
  },
  "allowedPayloadTypes": ["table", "json", "text", "binary", "embeddings", "image", "audio", "video"],
  "nodes": {
    "model": {
      "in": ["text", "json", "table", "image", "audio", "video"],
      "out": ["text", "json", "embeddings", "image", "audio", "video"],
      "ports": {
        "in": { "default": { "affinity": "work", "behavior": "single_item" } },
        "out": { "default": { "affinity": "work" } }
      },
      "inputContracts": {
        "workInputs": ["in"],
        "paramInputs": ["param_filters", "param_context"],
        "controlInputs": ["control_in"]
      }
    },
    "llm": {
      "in": ["text", "json", "table"],
      "out": ["text", "json", "embeddings"],
      "ports": {
        "in": { "default": { "affinity": "work", "behavior": "single_item" } },
        "out": { "default": { "affinity": "work" } }
      },
      "inputContracts": {
        "workInputs": ["in"],
        "paramInputs": ["param_filters", "param_context"],
        "controlInputs": ["control_in"]
      }
    },
    "transform": {
      "in": ["table", "json", "text"],
      "out": ["table", "json"],
      "ports": {
        "in": { "default": { "affinity": "work", "behavior": "single_item" } },
        "out": {
          "default": { "affinity": "work" },
          "out_reject": { "affinity": "work" }
        }
      },
      "inputContracts": {
        "workInputs": ["in"],
        "paramInputs": ["param_config"],
        "controlInputs": ["control_in"]
      }
    },
    "source": {
      "in": [],
      "out": ["table", "json", "text", "binary"],
      "ports": {
        "in": {},
        "out": { "default": { "affinity": "work" } }
      },
      "inputContracts": {
        "workInputs": [],
        "paramInputs": ["param_config"],
        "controlInputs": ["control_in"]
      }
    },
    "tool": {
      "in": ["table", "json", "text", "binary", "embeddings"],
      "out": ["text", "json", "binary"],
      "ports": {
        "in": { "default": { "affinity": "work", "behavior": "single_item" } },
        "out": { "default": { "affinity": "work" } }
      },
      "inputContracts": {
        "workInputs": ["in"],
        "paramInputs": ["param_config"],
        "controlInputs": ["control_in"]
      },
      "byProvider": {
        "mcp": {
          "in": ["table", "json", "text", "binary", "embeddings"],
          "out": ["text", "json", "binary"]
        },
        "http": {
          "in": ["table", "json", "text", "binary", "embeddings"],
          "out": ["text", "json", "binary"]
        },
        "function": {
          "in": ["table", "json", "text", "binary", "embeddings"],
          "out": ["text", "json", "binary"]
        },
        "python": {
          "in": ["table", "json", "text", "binary", "embeddings"],
          "out": ["text", "json", "binary"]
        },
        "js": {
          "in": ["table", "json", "text", "binary", "embeddings"],
          "out": ["text", "json", "binary"]
        },
        "shell": {
          "in": ["table", "json", "text", "binary", "embeddings"],
          "out": ["text", "json"]
        },
        "db": {
          "in": ["table", "json", "text", "binary", "embeddings"],
          "out": ["text", "json"]
        },
        "builtin": {
          "in": ["table", "json", "text", "binary", "embeddings"],
          "out": ["text", "json"]
        }
      }
    },
    "component": {
      "in": ["table", "json", "text", "binary", "embeddings"],
      "out": ["table", "json", "text", "binary", "embeddings"],
      "ports": {
        "in": { "default": { "affinity": "work", "behavior": "single_item" } },
        "out": { "default": { "affinity": "work" } }
      },
      "inputContracts": {
        "workInputs": ["in"],
        "paramInputs": ["param_config"],
        "controlInputs": ["control_in"]
      }
    }
  }
}
